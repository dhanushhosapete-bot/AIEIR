# Copy to .env (git-ignored). Real deployments use a secret manager.
ANTHROPIC_API_KEY=
EIR_MODEL=claude-sonnet-5-5
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
GRADER_MODEL=claude-opus-5-5
EIR_PROMPT_VERSION=eir_system_v1

DATABASE_URL=postgresql://aieir_app:CHANGE_ME@localhost:5432/aieir
STAFF_DATABASE_URL=postgresql://aieir_staff:CHANGE_ME@localhost:5432/aieir
ADMIN_DATABASE_URL=postgresql://postgres@localhost:5432/aieir

# 32-byte keys, base64. First one encrypts; all listed decrypt (rotation).
# python -c "import os,base64;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
AIEIR_DATA_KEYS=

# RED alert email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ONCALL_PRIMARY_EMAIL=
ONCALL_SECONDARY_EMAIL=
STAFF_DASHBOARD_URL=https://your-host/staff

RETENTION_DAYS=365
REVIEW_SAMPLE_RATE=0.02
